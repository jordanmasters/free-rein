      },
      {
        "value": "lmstudio/google/gemma-3n-e4b",
        "name": "Gemma 3n (LM Studio)",
        "example": true
      }
    ],
    "default": "the --model flag, else model in config, else the last one used",
    "set_by": {
      "file": "opencode.json",
      "key": "model (provider_id/model_id)"
    },
    "how": "Runs models from any of 75+ connected providers, or local models; pick one with /models, --model or model in opencode.json.",
    "status": "confirmed",
    "source": "models",
    "repo": {
      "file": "opencode.json",
      "format": "json",
      "key": "model",
      "source": "config"
    }
  }
