      "source": "hooks"
    },
    "independent-checker": {
      "how": "A reviewer subagent in .gemini/agents",
      "status": "believed",
      "source": "subagents"
    },
    "visual-check": {
      "how": "No documented way",
      "status": "none"
    },
    "harness-checker": {
      "how": "Free Rein's checks (/address-findings), with a Gemini adapter (not built)",
      "status": "believed"
    },
    "criteria": {
      "how": "A done_when field on each task, read from files",
