      "status": "confirmed",
      "source": "sessions"
    },
    "status-line": {
      "how": "Footer items can be chosen and hidden (ui.footer.*); no custom script status line",
      "status": "believed",
      "source": "config"
    },
    "telemetry-export": {
      "how": "OpenTelemetry (telemetry.*), off by default",
      "status": "confirmed",
      "source": "telemetry"
    },
    "cost-tracking": {
      "how": "/stats shows session, model and tool usage incl. token counts; telemetry exports token metrics",
      "status": "confirmed",
      "source": "commands-ref"
    },
    "session-state": {
      "how": "Checkpointing (off by default), or a state file kept by hooks",
      "status": "believed",
      "source": "checkpointing"
    },
    "task-list": {
