  "answers": {
    "proj-instructions": {
      "how": "GEMINI.md at the repo root; context.fileName can add AGENTS.md; no size cap",
      "status": "confirmed",
      "source": "context"
    },
    "personal-instructions": {
      "how": "~/.gemini/GEMINI.md",
      "status": "confirmed",
      "source": "context"
    },
    "folder-instructions": {
      "how": "GEMINI.md in parent and sub folders, loaded on demand when tools touch a folder; @file imports up to 5 deep, stopping at .git (context.memoryBoundaryMarkers)",
      "status": "confirmed",
      "source": "context"
    },
    "live-injection": {
      "how": "A BeforeAgent or SessionStart hook (SessionStart only advises)",
      "status": "confirmed",
      "source": "hooks"
    },
    "contracts": {
      "how": "GEMINI.md files loaded when a tool enters a directory",
      "status": "believed",
      "source": "context"
    },
    "modes": {
      "how": "Approval modes and Plan Mode; no custom modes",
      "status": "believed",
      "source": "config"
    },
    "plan-first": {
      "how": "Plan mode (/plan): read-only research and a written plan before any edits",
      "status": "confirmed",
      "source": "plan-mode"
    },
    "commands": {
      "how": "TOML files in .gemini/commands (project) or ~/.gemini/commands (user) become slash commands",
      "status": "confirmed",
      "source": "custom-commands"
    },
    "git-workflow": {
      "how": "No commit attribution or branch settings; only experimental git worktrees for parallel sessions",
      "status": "believed",
      "source": "git-worktrees"
    },
    "review-workflow": {
      "how": "No built-in review command; /setup-github installs GitHub Actions that review PRs",
      "status": "believed",
      "source": "commands-ref"
    },
    "skills": {
      "how": ".gemini/skills or ~/.gemini/skills (SKILL.md)",
      "status": "confirmed",
      "source": "config"
    },
    "mcp": {
      "how": "mcpServers in settings.json",
      "status": "confirmed",
      "source": "config"
    },
    "plugins": {
      "how": "Extensions bundle commands, MCP servers, context, hooks, skills, subagents and policies",
      "status": "confirmed",
      "source": "extensions"
    },
    "web": {
      "how": "google_web_search and web_fetch, built in",
      "status": "confirmed",
      "source": "tools"
    },
    "connected-accounts": {
      "how": "No documented way",
      "status": "none"
    },
    "subagents": {
      "how": "Built-in investigator, cli_help, generalist; custom in .gemini/agents",
      "status": "confirmed",
      "source": "subagents"
    },
    "orchestration": {
      "how": "Remote subagents over A2A",
      "status": "believed",
      "source": "subagents"
    },
    "autonomous-runs": {
      "how": "No scheduling documented",
      "status": "none"
    },
    "model-routing": {
      "how": "Each subagent can name its own model; default inherits the session model",
      "status": "confirmed",
      "source": "subagents"
    },
    "installer": {
      "how": "An install script",
      "status": "believed"
    },
    "setup": {
      "how": "A setup script the agent runs first",
      "status": "believed"
    },
    "pins": {
      "how": "A lockfile and a runtime version file in the repo",
      "status": "confirmed"
    },
    "settings-split": {
      "how": "User ~/.gemini/settings.json and project .gemini/settings.json; no separate personal per-project file",
      "status": "believed",
      "source": "config"
    },
    "env-keys": {
      "how": "Loads .env files (project, parents, home); settings can reference $VARS",
      "status": "confirmed",
      "source": "config"
    },
    "managed-policy": {
      "how": "System settings file overrides all other settings; Admin tier policies outrank user ones",
      "status": "confirmed",
      "source": "enterprise"
    },
    "permissions": {
      "how": "The TOML policy engine (allow, ask, deny), plus approval modes: Default, Auto-Edit, Plan and YOLO (command line only); security.disableYoloMode and admin Strict Mode forbid YOLO",
      "status": "confirmed",
      "source": "policy"
    },
    "hard-gate": {
      "how": "A BeforeTool hook, or a deny rule in the policy engine",
      "status": "confirmed",
      "source": "policy"
    },
    "secrets-out": {
      "how": ".geminiignore hides paths from tools that honour it; policy rules can deny tools",
      "status": "confirmed",
      "source": "ignore"
    },
    "sandbox": {
      "how": "Seatbelt, Docker, Podman, gVisor or LXC; off by default but on automatically with YOLO; it can widen for one blocked command when you allow it",
      "status": "confirmed",
      "source": "sandbox"
    },
    "network-limits": {
      "how": "Sandbox profiles can route network through a proxy; browser agent has an allowed-domain list",
      "status": "confirmed",
      "source": "sandbox"
    },
    "spend-limits": {
      "how": "model.maxSessionTurns (unlimited by default); subagents stop at 30 turns or 10 minutes; headless exits with code 53 at the limit; no cost budget",
      "status": "confirmed",
      "source": "schema-0640"
    },
    "human-gate": {
      "how": "ask_user, and approval prompts on writes",
      "status": "confirmed",
      "source": "tools"
    },
    "notifications": {
      "how": "Experimental terminal notifications when it needs approval or finishes (general.enableNotifications)",
      "status": "confirmed",
      "source": "notifications"
    },
    "completion-check": {
      "how": "An AfterAgent hook",
      "status": "believed",
      "source": "config"
    },
    "rewind": {
      "how": "/rewind or Esc twice rolls back the chat, the file changes, or both; shell commands are not undone; checkpointing for /restore is off by default",
      "status": "confirmed",
      "source": "rewind"
    },
    "check-commands": {
      "how": "Scripts named in GEMINI.md",
      "status": "confirmed"
    },
    "schema": {
      "how": "Validators it runs",
      "status": "confirmed"
    },
    "auto-fix": {
      "how": "AfterTool hooks can run after edits (e.g. tests); no formatter recipe documented",
