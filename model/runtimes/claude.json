  "run_modes": {
    "modes": [
      {
        "id": "default",
        "name": "Manual",
        "level": "asks"
      },
      {
        "id": "acceptEdits",
        "name": "Edit automatically",
        "level": "edits"
      },
      {
        "id": "auto",
        "name": "Auto",
        "level": "checker",
        "note": "a separate model checks each action; your ask rules still prompt"
      },
      {
        "id": "bypassPermissions",
        "name": "Bypass permissions",
        "level": "all",
        "note": "only when enabled at launch; deny rules still hold"
      },
      {
        "id": "plan",
        "name": "Plan",
        "level": "read-only"
      },
      {
        "id": "dontAsk",
        "name": "Don't ask",
        "level": "allowed-only",
        "note": "for CI: what would ask is refused"
      }
    ],
    "default": "auto",
    "default_note": "the default from 2.1.283; Manual where Auto isn't available",
    "set_by": [
      {
        "file": ".claude/settings.local.json",
        "format": "json",
        "key": "permissions.defaultMode",
        "values": {
          "manual": "default"
        },
        "ignore": [
          "auto",
          "bypassPermissions"
        ]
      },
      {
        "file": ".claude/settings.json",
        "format": "json",
        "key": "permissions.defaultMode",
        "values": {
          "manual": "default"
        },
        "ignore": [
          "auto",
          "bypassPermissions"
        ]
      },
      {
        "file": "~/.claude/settings.json",
        "format": "json",
        "key": "permissions.defaultMode",
        "values": {
          "manual": "default"
        }
      }
    ],
    "status": "confirmed",
    "source": "cc-modes"
  },
