        "id": "user",
        "name": "You, every repo",
        "files": [
          "~/.claude/CLAUDE.md",
          "~/.claude/settings.json",
          "~/.claude/ skills, agents and commands"
        ],
        "status": "confirmed",
        "source": "cc-settings"
      }
    ],
    "folders": {
      "how": "A subfolder's CLAUDE.md, and .claude/rules scoped by paths, load once it works in that folder",
      "status": "confirmed",
      "source": "cc-memory"
    },
    "loads": {
      "instructions": {
        "how": "CLAUDE.md and CLAUDE.local.md from the filesystem root down to the working folder, ~/.claude/CLAUDE.md, the managed CLAUDE.md and .claude/rules files without paths load in full at launch; a subfolder's files and rules with paths load once it works there",
        "status": "confirmed",
        "source": "cc-memory"
      },
      "skills": {
        "how": "Each skill's description (with when_to_use) is in context from the start, so Claude knows when to use it; the body loads only when the skill is used, and stays. A skill with disable-model-invocation has no description in context",
        "status": "confirmed",
        "source": "cc-skills",
        "description_chars": 1536
      },
      "memory": {
        "how": "Auto memory: notes Claude writes for itself, on by default, one folder per git repository (worktrees and subfolders share it), on this machine only. The first 200 lines or 25 KB of MEMORY.md, its index, load at the start of every session; the topic notes are read on demand. autoMemoryDirectory moves it",
        "status": "confirmed",
        "source": "cc-memory",
        "dir": "~/.claude/projects/<project>/memory",
        "index": "MEMORY.md",
        "start_lines": 200,
        "start_kb": 25,
        "per": "repo",
        "on": true,
        "by_hand": true
      }
    },
    "session": {
      "how": "--settings, flags such as --model and --permission-mode, and choices made during a run",
      "status": "confirmed",
      "source": "cc-settings"
    },
    "combine": {
      "settings": {
        "how": "The most specific level that sets a key wins: your organization, then --settings, then this repo just you, this repo shared, and you",
        "status": "confirmed",
        "source": "cc-settings"
      },
      "rules": {
        "how": "Permission rules from every level are merged; an allow from one file doesn't outrank an ask from another",
        "status": "confirmed",
        "source": "cc-settings"
      },
      "instructions": {
        "how": "Every level's CLAUDE.md is loaded and joined, broadest first; none replaces another",
        "status": "confirmed",
        "source": "cc-memory"
      }
    }
  },
