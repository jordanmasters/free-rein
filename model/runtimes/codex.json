  "run_modes": {
    "modes": [
      {
        "id": "read-only",
        "name": "Read-only",
        "level": "asks"
      },
      {
        "id": "ask",
        "name": "Ask for approval",
        "level": "edits",
        "note": "edits inside the sandbox; asks to go beyond it"
      },
      {
        "id": "approve",
        "name": "Approve for me",
        "level": "checker",
        "note": "a reviewer agent approves what would ask"
      },
      {
        "id": "full",
        "name": "Full access",
        "level": "all"
      },
      {
        "id": "plan",
        "name": "Plan (/plan)",
        "level": "read-only"
      }
    ],
    "default": "ask",
    "default_note": "in a folder under version control; read-only elsewhere",
    "set_by": [
      {
        "file": ".codex/config.toml",
        "format": "toml",
        "key": "approvals_reviewer",
        "values": {
          "auto_review": "approve",
          "user": "ask"
        }
      },
      {
        "file": ".codex/config.toml",
        "format": "toml",
        "key": "sandbox_mode",
        "values": {
          "read-only": "read-only",
          "workspace-write": "ask",
          "danger-full-access": "full"
        }
      },
      {
        "file": "~/.codex/config.toml",
        "format": "toml",
        "key": "approvals_reviewer",
        "values": {
          "auto_review": "approve",
          "user": "ask"
        }
      },
      {
        "file": "~/.codex/config.toml",
        "format": "toml",
        "key": "sandbox_mode",
        "values": {
          "read-only": "read-only",
          "workspace-write": "ask",
          "danger-full-access": "full"
        }
      }
    ],
    "status": "confirmed",
