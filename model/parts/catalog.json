{
  "version": 1,
  "note": "The parts bin. Each part is a ROLE, named independently of any runtime; `runtimes` records how a given runtime realizes it. `node_type` ties the part to model/graph-schema.md, which makes parts of the same type candidates for substitution. `provides` and `requires` are what make a swap checkable: a part may only be placed where its requirements are provided.",
  "capabilities": {
    "hook-runtime": "the runtime can execute a script on a tool-call event and act on its exit status",
    "structured-prompt": "the runtime can render a fixed set of options for the human to select",
    "subagent-runtime": "the runtime can delegate work to a separate context",
    "schedule-runtime": "the runtime can fire work on a schedule",
    "context-injection": "something places standing text into the model's context",
    "routable-unit": "a named unit the runtime can route to or invoke",
    "coordination-contract": "a protocol governing behavior across subsequent turns",
    "effect-gate": "an interposition point on an effect path",
    "substrate": "a stateful store the harness reads or writes",
    "delegation": "work handed to a separate context or process",
    "external-capability": "capability reached outside the runtime's built-ins",
    "temporal-activation": "work triggered by time rather than by intent",
    "sandbox": "an isolated place to act without touching the real workspace",
    "binding": "configuration resolved at runtime into paths and values",
    "trace": "an append-only record of what happened"
  },
  "parts": [
    {
      "id": "project-constitution",
      "node_type": "surface",
      "role": "standing instructions injected at session start",
      "provides": [
        "context-injection"
      ],
      "requires": [],
      "runtimes": {
        "claude-code": {
          "realization": "CLAUDE.md",
          "verified": true
        },
        "codex": {
          "realization": "AGENTS.md",
          "verified": true
        }
      }
    },
    {
      "id": "user-constitution",
      "node_type": "surface",
      "role": "cross-project standing instructions",
      "provides": [
        "context-injection"
      ],
      "requires": [],
      "runtimes": {
        "claude-code": {
          "realization": "~/.claude/CLAUDE.md",
          "verified": true
        },
        "codex": {
          "realization": "~/.codex/AGENTS.md",
          "verified": false
        }
      }
    },
    {
      "id": "injected-banner",
      "node_type": "surface",
      "role": "per-prompt context injected by infrastructure",
      "provides": [
        "context-injection"
      ],
      "requires": [
        "hook-runtime"
      ],
      "runtimes": {
        "claude-code": {
          "realization": "UserPromptSubmit hook stdout",
          "verified": true
        },
        "codex": {
          "realization": "UserPromptSubmit or SessionStart hook adding context",
          "verified": true
        }
      }
    },
    {
      "id": "persistent-memory",
      "node_type": "surface",
      "role": "facts that survive across sessions",
      "provides": [
        "context-injection"
      ],
      "requires": [],
      "runtimes": {
        "claude-code": {
          "realization": "memory directory",
          "verified": true
        },
        "codex": {
          "realization": "memories, off by default (features.memories)",
          "verified": true
        }
      }
    },
    {
      "id": "skill",
      "node_type": "unit",
      "role": "routable unit: routing signal plus body, loaded on match",
      "provides": [
        "routable-unit"
      ],
      "requires": [],
      "runtimes": {
        "claude-code": {
          "realization": ".claude/skills/<name>/SKILL.md",
          "verified": true
        },
        "codex": {
          "realization": "skills, configured under skills.* in config.toml",
          "verified": true
        }
      }
    },
    {
      "id": "slash-command",
      "node_type": "unit",
      "role": "manually invoked unit",
      "provides": [
        "routable-unit"
      ],
      "requires": [],
      "runtimes": {
        "claude-code": {
          "realization": "/<skill-name>",
          "verified": true
        },
        "codex": {
          "realization": "/<prompt-name>",
          "verified": false
        }
      }
    },
    {
      "id": "engine-protocol",
      "node_type": "contract",
      "role": "behavioral contract loaded once, governing subsequent turns",
      "provides": [
        "coordination-contract"
      ],
      "requires": [
        "context-injection"
      ],
      "runtimes": {
        "claude-code": {
          "realization": "engines/<name>/PROTOCOL.md",
          "verified": true
        },
        "codex": {
          "realization": null,
          "verified": false
        }
      }
    },
    {
      "id": "event-hook-gate",
      "node_type": "gate",
      "role": "deterministic interception of a tool call before it runs",
      "imparts": {
        "verifier": "deterministic",
        "binding": "blocking",
        "locus": "infrastructure"
      },
      "provides": [
        "effect-gate"
      ],
      "requires": [
        "hook-runtime"
      ],
      "runtimes": {
        "claude-code": {
          "realization": "PreToolUse hook with non-zero exit",
          "verified": true
        },
        "codex": {
          "realization": "PreToolUse hook in config.toml or hooks.json (refusal not confirmed)",
          "verified": false
        }
      }
    },
    {
      "id": "permission-policy",
      "node_type": "gate",
      "role": "declarative allow / deny / ask on tool use",
      "imparts": {
        "verifier": "structural",
        "binding": "blocking",
        "locus": "infrastructure"
      },
      "provides": [
        "effect-gate"
      ],
      "requires": [],
